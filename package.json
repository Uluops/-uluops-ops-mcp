{
  "name": "@uluops/ops-mcp",
  "version": "0.9.2",
  "description": "MCP server for the UluOps Platform API — validation tracking, analytics, and issue management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "uluops-ops-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tool-policies.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "chmod +x dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm test && npm audit --audit-level=high --omit=dev && npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "uluops",
    "validation",
    "analytics",
    "claude",
    "claude-code",
    "model-context-protocol"
  ],
  "author": "aself101",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uluops/ops-uluops-mcp.git"
  },
  "homepage": "https://github.com/Uluops/ops-uluops-mcp#readme",
  "bugs": {
    "url": "https://github.com/Uluops/ops-uluops-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@uluops/ops-sdk": "^5.7.0",
    "mcp-secure-server": "0.0.16-security",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4",
    "vitest": "3.2.6"
  },
  "overrides": {
    "hono": "4.12.25"
  }
}
